{
    "name": "monorepo/php-stack-minimum",
    "description": "Slim 4 minimum — Ponytail Minimum (YAGNI), thêm lib khi cần",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}