{
    "name": "monorepo/php-stack-starter",
    "description": "Slim 4 starter runnable — from lib/php-stack",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "league/plates": "^3.5",
        "monolog/monolog": "^3.7",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16",
        "tuupola/slim-jwt-auth": "^3.0",
        "firebase/php-jwt": "^6.0",
        "omnipay/omnipay": "^3.0",
        "phpviet/omnipay-vnpay": "^1.0",
        "nikolaposa/rate-limit": "^1.0",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "pestphp/pest": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "ext-redis": "For Redis-backed rate-limit (otherwise file fallback)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "migrate": "phinx migrate -c phinx.php",
        "test": "pest",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --level=max src/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}