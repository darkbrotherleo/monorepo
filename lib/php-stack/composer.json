{
    "name": "monorepo/php-stack",
    "description": "Slim 4 starter — filtered from ziadoz/awesome-php for PHP thuần/Slim",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "league/plates": "^3.5",
        "monolog/monolog": "^3.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "pest",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}